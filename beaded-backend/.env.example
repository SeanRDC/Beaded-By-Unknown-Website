# Required. The server refuses to start without these.
JWT_SECRET=
ADMIN_SECRET=
MONGODB_URI=
# The shop's address. List several origins separated by commas if needed.
CLIENT_URL=https://www.beadedbyunknown.shop

# Payments
PAYMONGO_SECRET_KEY=
# From the PayMongo dashboard. Webhooks are refused until this is set.
PAYMONGO_WEBHOOK_SECRET=
# Leave unset to stay in showcase mode (every checkout charges ₱1). Set to live for real prices.
CHECKOUT_MODE=

# Email
RESEND_API_KEY=

# Pictures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Defaults to beaded-shop.
FIREBASE_PROJECT_ID=

# Optional. Defaults to 4242.
PORT=
